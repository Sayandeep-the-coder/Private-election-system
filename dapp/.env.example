# ──────────────────────────────────────────────
# Midnight Network Configuration
# ──────────────────────────────────────────────
# Copy this file to .env.local and fill in values.
# .env.local is gitignored and will never be committed.

# Default network: preview | preprod | undeployed
NEXT_PUBLIC_DEFAULT_NETWORK=preprod

# ──────────────────────────────────────────────
# Indexer Endpoints (Override defaults if needed)
# ──────────────────────────────────────────────
NEXT_PUBLIC_INDEXER_PREVIEW_HTTP=https://indexer.preview.midnight.network/api/v4/graphql
NEXT_PUBLIC_INDEXER_PREVIEW_WS=wss://indexer.preview.midnight.network/api/v4/graphql/ws

NEXT_PUBLIC_INDEXER_PREPROD_HTTP=https://indexer.preprod.midnight.network/api/v4/graphql
NEXT_PUBLIC_INDEXER_PREPROD_WS=wss://indexer.preprod.midnight.network/api/v4/graphql/ws

NEXT_PUBLIC_INDEXER_LOCAL_HTTP=http://localhost:8088/api/v3/graphql
NEXT_PUBLIC_INDEXER_LOCAL_WS=ws://localhost:8088/api/v3/graphql/ws

# ──────────────────────────────────────────────
# Deployed Contract (for reference / auto-fill)
# ──────────────────────────────────────────────
NEXT_PUBLIC_DEPLOYED_CONTRACT_ADDRESS=
